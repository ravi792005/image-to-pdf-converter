# Server
PORT=5000
NODE_ENV=development

# CORS - comma separated list of allowed origins (your Vercel frontend URL in production)
CLIENT_ORIGIN=http://localhost:5173

# Uploads
UPLOAD_DIR=uploads
TEMP_DIR=temp
MAX_FILE_SIZE_MB=20
MAX_TOTAL_SIZE_MB=100
MAX_FILES=50

# File retention (minutes) - files older than this are purged by the cleanup job
FILE_RETENTION_MINUTES=5

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
